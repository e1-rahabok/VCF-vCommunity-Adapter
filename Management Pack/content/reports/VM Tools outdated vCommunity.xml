<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Content>
    
    <Views>
        
<ViewDef id="75d99f2b-4f61-49df-ab8f-952689728ae6">
                        
            <Title>VM Tools outdated</Title>
                        
            <Description>Count of VMs with VMware Tools not current. Tools are part of vSphere best practices as it provides a set of drivers and improve visibility.

A blank status means the VMware Tools are not even installed.
</Description>
                        
            <SubjectType adapterKind="VMWARE" filter="[[{&quot;filterType&quot;:&quot;properties&quot;,&quot;metricKey&quot;:&quot;summary|guest|toolsVersionStatus2&quot;,&quot;condition&quot;:&quot;NOT_EQUALS&quot;,&quot;metricValue&quot;:{&quot;value&quot;:&quot;Guest Tools Current&quot;,&quot;isStringMetric&quot;:true},&quot;transform&quot;:&quot;CURRENT&quot;}]]" resourceKind="VirtualMachine" type="descendant"/>
                        
            <Usage>dashboard</Usage>
                        
            <Usage>report</Usage>
                        
            <Usage>content</Usage>
                        
            <Controls>
                                
                <Control id="time-interval-selector_id_1019" type="time-interval-selector" visible="false">
                                        
                    <Property name="advancedTimeMode" value="false"/>
                                        
                    <Property name="unit" value="DAYS"/>
                                        
                    <Property name="count" value="7"/>
                                    
                </Control>
                                
                <Control id="attributes-selector_id_1020" type="attributes-selector" visible="false">
                                        
                    <Property name="attributeInfos">
                                                
                        <List>
                                                        
                            <Item>
                                                                
                                <Value>
                                                                        
                                    <Property name="objectType" value="RESOURCE"/>
                                                                        
                                    <Property name="attributeKey" value="summary|guest|toolsRunningStatus"/>
                                                                        
                                    <Property name="isStringAttribute" value="true"/>
                                                                        
                                    <Property name="adapterKind" value="VMWARE"/>
                                                                        
                                    <Property name="resourceKind" value="VirtualMachine"/>
                                                                        
                                    <Property name="rollUpCount" value="0"/>
                                                                        
                                    <Property name="isProperty" value="true"/>
                                                                    
                                </Value>
                                                            
                            </Item>
                                                    
                        </List>
                                            
                    </Property>
                                    
                </Control>
                                
                <Control id="buckets-control_id_1021" type="buckets-control" visible="false">
                                        
                    <Property name="bucketCount" value="1"/>
                                        
                    <Property name="dynamicCalcFunction" value="DISCRETE"/>
                                        
                    <Property name="isDynamic" value="true"/>
                                        
                    <Property name="isSum" value="false"/>
                                    
                </Control>
                                
                <Control id="metadata_id_1022" type="metadata" visible="false">
                                        
                    <Property name="maxPointsCount" value="5000"/>
                                        
                    <Property name="distributionColor" value="D23292"/>
                                        
                    <Property name="hideObjectNameColumn" value="false"/>
                                        
                    <Property name="listTopResultSize" value="-1"/>
                                    
                </Control>
                            
            </Controls>
                        
            <DataProviders>
                                
                <DataProvider dataType="distribution-view" id="distribution-view_id_1018"/>
                            
            </DataProviders>
                        
            <Presentation type="pie-chart"/>
                    
        </ViewDef>
            
    </Views>
    
</Content>
