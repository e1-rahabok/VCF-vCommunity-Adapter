                                    <Property name="isStringAttribute" value="false"/>
                                                                        
                                    <Property name="adapterKind" value="VMWARE"/>
                                                                        
                                    <Property name="resourceKind" value="VirtualMachine"/>
                                                                        
                                    <Property name="rollUpCount" value="0"/>
                                                                        
                                    <Property name="transformations">
                                                                                
                                        <List>
                                                                                        
                                            <Item value="CURRENT"/>
                                                                                    
                                        </List>
                                                                            
                                    </Property>
                                                                        
