<Content>
    
    <Views>
        
<ViewDef id="ca5859dc-1574-4c4a-88c6-b45beceff0f2">
                        
            <Title>VM with old Snapshots </Title>
                        
            <Description>Count of snapshots grouped by age. Snapshot should only be used as protection of change. Once change is successful, snapshot does more  harm as it impacts performance and take up space. Delete them before they are forgotten.</Description>
                        
            <SubjectType adapterKind="VMWARE" filter="[[{&quot;filterType&quot;:&quot;properties&quot;,&quot;metricKey&quot;:&quot;diskspace|snapshot|snapshotAge&quot;,&quot;condition&quot;:&quot;GREATER_THAN&quot;,&quot;metricValue&quot;:{&quot;value&quot;:7,&quot;isStringMetric&quot;:false},&quot;transform&quot;:&quot;CURRENT&quot;}]]" resourceKind="VirtualMachine" type="descendant"/>
                        
            <Usage>dashboard</Usage>
                        
            <Usage>report</Usage>
                        
            <Usage>content</Usage>
                        
            <Controls>
                                
